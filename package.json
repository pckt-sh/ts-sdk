{
  "name": "@pckt-sh/sdk",
  "version": "1.2.0",
  "description": "TypeScript SDK for the PCKT API, generated from its OpenAPI spec.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pckt-sh/ts-sdk.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "openapi-ts",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
